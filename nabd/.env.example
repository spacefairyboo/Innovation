# Copy to .env.local and fill in what you need. Every variable is optional:
# with none of them set, Echo seeds a demo organization and every AI feature
# falls back to its built-in engine.

# ---------- AI ----------
# The OpenAI key that powers translation, the check-in assistant, bulk
# matching, the advisor, and document review.
# OPENAI_API_KEY=sk-...

# Override the default model (gpt-5.4-mini).
# OPENAI_MODEL=gpt-5.4-mini

# Testing switch. AI_ONLY=1 stands the built-in engines down: the check-in
# chat sends every message to the model instead of parsing it locally, bulk
# matching reports the model's matches with no local backfill, and a failed
# call says so rather than being answered locally. Needs OPENAI_API_KEY -
# without a key there is nothing to fall forward to, so the flag is ignored.
# AI_ONLY=1

# ---------- storage ----------
# Where the SQLite file lives (default: data/).
# DATA_DIR=data

# ---------- email ----------
# SMTP delivery for the briefing digest and reminders. Without it the
# outbox still records what would have been sent.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=echo@example.com

# ---------- Outlook (mail scanning + calendar) ----------
# OUTLOOK_TENANT_ID=
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=

# ---------- logging ----------
# debug | info | warn | error   (default: info)
# LOG_LEVEL=info
